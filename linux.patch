diff --git a/Makefile b/Makefile
index c28f11c61..6d76c2d07 100644
--- a/Makefile
+++ b/Makefile
@@ -1377,7 +1377,7 @@ PHONY += vmlinux
 #  vmlinux: private export LDFLAGS_vmlinux := $(LDFLAGS_vmlinux)
 vmlinux: private _LDFLAGS_vmlinux := $(LDFLAGS_vmlinux)
 vmlinux: export LDFLAGS_vmlinux = $(_LDFLAGS_vmlinux)
-vmlinux: vmlinux.o $(KBUILD_LDS) modpost
+vmlinux: vmlinux.o $(KBUILD_LDS) $(if $(filter wasm,$(SRCARCH)),,modpost)
 	$(Q)$(MAKE) -f $(srctree)/scripts/Makefile.vmlinux
 
 # The actual objects are generated when descending,
@@ -1415,7 +1415,7 @@ archprepare: outputmakefile archheaders archscripts scripts include/config/kerne
 	include/generated/rustc_cfg remove-stale-files
 
 prepare0: archprepare
-	$(Q)$(MAKE) $(build)=scripts/mod
+	$(if $(filter wasm,$(SRCARCH)),,$(Q)$(MAKE) $(build)=scripts/mod)
 	$(Q)$(MAKE) $(build)=. prepare
 
 # All the preparing..
diff --git a/scripts/Makefile.clang b/scripts/Makefile.clang
index b67636b28..b37824b5c 100644
--- a/scripts/Makefile.clang
+++ b/scripts/Makefile.clang
@@ -12,6 +12,7 @@ CLANG_TARGET_FLAGS_riscv	:= riscv64-linux-gnu
 CLANG_TARGET_FLAGS_s390		:= s390x-linux-gnu
 CLANG_TARGET_FLAGS_sparc	:= sparc64-linux-gnu
 CLANG_TARGET_FLAGS_x86		:= x86_64-linux-gnu
+CLANG_TARGET_FLAGS_wasm		:= wasm32-unknown-unknown
 # This is only for i386 UM builds, which need the 32-bit target not -m32
 CLANG_TARGET_FLAGS_i386		:= i386-linux-gnu
 CLANG_TARGET_FLAGS_um		:= $(CLANG_TARGET_FLAGS_$(SUBARCH))
