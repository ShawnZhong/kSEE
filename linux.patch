diff --git a/arch/wasm/kernel/syscall.c b/arch/wasm/kernel/syscall.c
new file mode 100644
index 000000000..993caf6ab
--- /dev/null
+++ b/arch/wasm/kernel/syscall.c
@@ -0,0 +1,72 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * System call entry. A user module imports the kernel's syscall export
+ * directly, so a syscall is a plain wasm call into the kernel instance.
+ */
+#include <linux/entry-common.h>
+#include <linux/syscalls.h>
+#include <asm/syscall.h>
+#include <asm/wasm.h>
+
+#define __SYSCALL_WITH_COMPAT(nr, native, compat)	__SYSCALL(nr, native)
+
+/*
+ * Each entry weak: one this kernel does not build (COND_SYSCALL defines
+ * none, and sys_ni_syscall's entries have no __wasm_sys_ni_syscall) is
+ * left NULL by the linker, and returns -ENOSYS. So the table says which
+ * syscalls there are.
+ */
+#undef __SYSCALL
+#define __SYSCALL(nr, call)	long __wasm_##call(const struct pt_regs *) __weak;
+#include <asm/syscall_table_32.h>
+
+#undef __SYSCALL
+#define __SYSCALL(nr, call)	[nr] = __wasm_##call,
+
+const syscall_fn_t sys_call_table[__NR_syscalls] = {
+#include <asm/syscall_table_32.h>
+};
+
+__wasm_export(syscall) long wasm_syscall(long nr, u64 a0, u64 a1, u64 a2,
+					 u64 a3, u64 a4, u64 a5)
+{
+	struct pt_regs *regs = current_pt_regs();
+	void (*entry)(void) = current->thread.entry;
+
+	regs->syscall_nr = nr;
+	regs->args[0] = a0;
+	regs->args[1] = a1;
+	regs->args[2] = a2;
+	regs->args[3] = a3;
+	regs->args[4] = a4;
+	regs->args[5] = a5;
+
+	nr = syscall_enter_from_user_mode(regs, nr);
+	if (nr >= 0 && nr < __NR_syscalls && sys_call_table[nr])
+		regs->ret = sys_call_table[nr](regs);
+	else if (nr != -1)
+		regs->ret = sys_ni_syscall();
+	/*
+	 * After an execve, the new program runs instead, on a fresh stack
+	 * (the old program's frames are never returned to).
+	 */
+	if (current->thread.entry != entry)
+		wasm_restart_task(current, regs);
+	syscall_exit_to_user_mode(regs);
+	return regs->ret;
+}
+
+SYSCALL_DEFINE6(mmap2, unsigned long, addr, unsigned long, len,
+		unsigned long, prot, unsigned long, flags,
+		unsigned long, fd, unsigned long, pgoff)
+{
+	/* pgoff is in 4096-byte units, as on every 32-bit port. */
+	return ksys_mmap_pgoff(addr, len, prot, flags, fd,
+			       pgoff >> (PAGE_SHIFT - 12));
+}
+
+/* User signal handlers are not supported yet (see signal.c). */
+SYSCALL_DEFINE0(rt_sigreturn)
+{
+	return -ENOSYS;
+}
diff --git a/arch/wasm/kernel/time.c b/arch/wasm/kernel/time.c
new file mode 100644
index 000000000..261eece5f
--- /dev/null
+++ b/arch/wasm/kernel/time.c
@@ -0,0 +1,74 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Time: the clocksource reads the host's clock (virtual: it moves on as
+ * the kernel reads it, and the host skips it ahead while the CPU idles);
+ * the one-shot clockevent publishes its deadline in wasm_timer_deadline,
+ * which the host turns into WASM_IRQ_TIMER once it passes.
+ */
+#include <linux/clockchips.h>
+#include <linux/clocksource.h>
+#include <linux/init.h>
+#include <linux/sched/clock.h>
+#include <linux/sched_clock.h>
+#include <linux/time.h>
+#include <asm/wasm.h>
+
+u64 wasm_timer_deadline __aligned(8) = U64_MAX;
+
+static void wasm_set_deadline(u64 deadline)
+{
+	WRITE_ONCE(wasm_timer_deadline, deadline);
+}
+
+static u64 wasm_clocksource_read(struct clocksource *cs)
+{
+	return wasm_time_ns();
+}
+
+static struct clocksource wasm_clocksource = {
+	.name	= "wasm",
+	.rating	= 300,
+	.read	= wasm_clocksource_read,
+	.mask	= CLOCKSOURCE_MASK(64),
+	.flags	= CLOCK_SOURCE_IS_CONTINUOUS,
+};
+
+static int wasm_set_next_event(unsigned long delta,
+			       struct clock_event_device *ce)
+{
+	wasm_set_deadline(wasm_time_ns() + delta);
+	return 0;
+}
+
+static int wasm_set_state_shutdown(struct clock_event_device *ce)
+{
+	wasm_set_deadline(U64_MAX);
+	return 0;
+}
+
+static struct clock_event_device wasm_clockevent = {
+	.name			= "wasm",
+	.features		= CLOCK_EVT_FEAT_ONESHOT,
+	.rating			= 300,
+	.set_next_event		= wasm_set_next_event,
+	.set_state_shutdown	= wasm_set_state_shutdown,
+	.set_state_oneshot	= wasm_set_state_shutdown,
+};
+
+void wasm_timer_interrupt(void)
+{
+	wasm_clockevent.event_handler(&wasm_clockevent);
+}
+
+unsigned long long sched_clock(void)
+{
+	return wasm_time_ns();
+}
+
+void __init time_init(void)
+{
+	clocksource_register_hz(&wasm_clocksource, NSEC_PER_SEC);
+	wasm_clockevent.cpumask = cpu_possible_mask;
+	clockevents_config_and_register(&wasm_clockevent, NSEC_PER_SEC,
+					1000, ULONG_MAX);
+}
