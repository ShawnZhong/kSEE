diff --git a/arch/wasm/include/asm/syscall.h b/arch/wasm/include/asm/syscall.h
new file mode 100644
index 000000000..61fb36c67
--- /dev/null
+++ b/arch/wasm/include/asm/syscall.h
@@ -0,0 +1,49 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _ASM_WASM_SYSCALL_H
+#define _ASM_WASM_SYSCALL_H
+
+#include <uapi/linux/audit.h>
+#include <linux/err.h>
+#include <linux/sched.h>
+
+typedef long (*syscall_fn_t)(const struct pt_regs *regs);
+extern const syscall_fn_t sys_call_table[];
+
+static inline int syscall_get_nr(struct task_struct *task,
+				 struct pt_regs *regs)
+{
+	return regs->syscall_nr;
+}
+
+static inline void syscall_rollback(struct task_struct *task,
+				    struct pt_regs *regs)
+{
+}
+
+static inline long syscall_get_return_value(struct task_struct *task,
+					    struct pt_regs *regs)
+{
+	return regs->ret;
+}
+
+static inline void syscall_get_arguments(struct task_struct *task,
+					 struct pt_regs *regs,
+					 unsigned long *args)
+{
+	int i;
+
+	for (i = 0; i < 6; i++)
+		args[i] = regs->args[i];
+}
+
+static inline bool arch_syscall_is_vdso_sigreturn(struct pt_regs *regs)
+{
+	return false;
+}
+
+static inline int syscall_get_arch(struct task_struct *task)
+{
+	return 0;	/* no AUDIT_ARCH_* value for wasm */
+}
+
+#endif
diff --git a/arch/wasm/include/asm/syscall_wrapper.h b/arch/wasm/include/asm/syscall_wrapper.h
new file mode 100644
index 000000000..fd062f51e
--- /dev/null
+++ b/arch/wasm/include/asm/syscall_wrapper.h
@@ -0,0 +1,44 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Syscalls take a pt_regs pointer, so that every sys_call_table entry has
+ * the same wasm signature (call_indirect traps on a mismatch). The generic
+ * shims (__se_sys_x, which widens the arguments, and the body __do_sys_x)
+ * are inline: a syscall is one function, __wasm_sys_x.
+ */
+#ifndef _ASM_WASM_SYSCALL_WRAPPER_H
+#define _ASM_WASM_SYSCALL_WRAPPER_H
+
+#include <asm/ptrace.h>
+
+long sys_ni_syscall(void);
+
+#define SC_WASM_REGS_TO_ARGS(x, ...)					\
+	__MAP(x, __SC_ARGS, , regs->args[0], , regs->args[1],		\
+	      , regs->args[2], , regs->args[3], , regs->args[4],	\
+	      , regs->args[5])
+
+#define __SYSCALL_DEFINEx(x, name, ...)					\
+	long __wasm_sys##name(const struct pt_regs *regs);		\
+	static inline long __do_sys##name(__MAP(x, __SC_DECL, __VA_ARGS__)); \
+	static inline long __se_sys##name(__MAP(x, __SC_LONG, __VA_ARGS__)) \
+	{								\
+		long ret = __do_sys##name(__MAP(x, __SC_CAST, __VA_ARGS__)); \
+		__MAP(x, __SC_TEST, __VA_ARGS__);			\
+		__PROTECT(x, ret, __MAP(x, __SC_ARGS, __VA_ARGS__));	\
+		return ret;						\
+	}								\
+	long __wasm_sys##name(const struct pt_regs *regs)		\
+	{								\
+		return __se_sys##name(SC_WASM_REGS_TO_ARGS(x, __VA_ARGS__)); \
+	}								\
+	static inline long __do_sys##name(__MAP(x, __SC_DECL, __VA_ARGS__))
+
+#define SYSCALL_DEFINE0(sname)						\
+	long __wasm_sys_##sname(const struct pt_regs *__unused);	\
+	long __wasm_sys_##sname(const struct pt_regs *__unused)
+
+/* A syscall this kernel may not build: no entry (see sys_call_table). */
+#define COND_SYSCALL(name)						\
+	long __wasm_sys_##name(const struct pt_regs *regs) __weak
+
+#endif
