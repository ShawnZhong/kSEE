diff --git a/arch/wasm/kernel/binfmt_wasm.c b/arch/wasm/kernel/binfmt_wasm.c
new file mode 100644
index 000000000..220f9b58d
--- /dev/null
+++ b/arch/wasm/kernel/binfmt_wasm.c
@@ -0,0 +1,84 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Executables are position-independent wasm modules that import the
+ * kernel's memory (NOMMU: a program's pointers are kernel addresses). The
+ * host compiles the module; the kernel maps it pages for its data and its
+ * stack; the host instantiates it there, and gives its _start as an entry
+ * in the kernel's function table; the task calls it when it returns to
+ * user mode (see wasm_task_entry).
+ */
+#include <linux/binfmts.h>
+#include <linux/fs.h>
+#include <linux/init.h>
+#include <linux/mm.h>
+#include <linux/mman.h>
+#include <linux/sched.h>
+#include <linux/slab.h>
+#include <linux/vmalloc.h>
+#include <asm/wasm.h>
+
+#define WASM_STACK_SIZE	(64 * 1024)
+
+static int load_wasm_binary(struct linux_binprm *bprm)
+{
+	loff_t size = i_size_read(file_inode(bprm->file));
+	loff_t pos = 0;
+	unsigned long base, len, entry, clone_entry = 0;
+	long data = 0;
+	void *image;
+	int ret;
+
+	if (bprm->buf[0] != 0 || memcmp(bprm->buf, "\0asm\1\0\0\0", 8))
+		return -ENOEXEC;
+	if (size > INT_MAX)
+		return -E2BIG;
+
+	image = kvmalloc(size, GFP_KERNEL);
+	if (!image)
+		return -ENOMEM;
+	ret = kernel_read(bprm->file, image, size, &pos);
+	if (ret == size) {
+		data = wasm_user_load(image, size);
+		ret = data < 0 ? data : 0;
+	} else if (ret >= 0) {
+		ret = -EIO;
+	}
+	kvfree(image);
+	if (ret)
+		return ret;
+
+	ret = begin_new_exec(bprm);
+	if (ret)
+		return ret;
+	setup_new_exec(bprm);
+
+	/* Its data, then its stack (growing down from the end). */
+	len = PAGE_ALIGN(data) + WASM_STACK_SIZE;
+	base = vm_mmap(NULL, 0, len, PROT_READ | PROT_WRITE,
+		       MAP_PRIVATE | MAP_ANONYMOUS, 0);
+	if (IS_ERR_VALUE(base))
+		return base;
+	current->mm->start_data = base;
+	current->mm->end_data = base + data;
+	current->mm->start_stack = base + len;
+	entry = wasm_user_start(base, base + len, &clone_entry);
+	if (!entry)
+		return -ENOEXEC;
+
+	finalize_exec(bprm);
+	current->thread.entry = (void (*)(void))entry;
+	current->thread.clone_entry = (void (*)(void))clone_entry;
+	return 0;
+}
+
+static struct linux_binfmt wasm_format = {
+	.module		= THIS_MODULE,
+	.load_binary	= load_wasm_binary,
+};
+
+static int __init init_wasm_binfmt(void)
+{
+	register_binfmt(&wasm_format);
+	return 0;
+}
+core_initcall(init_wasm_binfmt);
diff --git a/arch/wasm/kernel/console.c b/arch/wasm/kernel/console.c
new file mode 100644
index 000000000..197e8327e
--- /dev/null
+++ b/arch/wasm/kernel/console.c
@@ -0,0 +1,70 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * The console: output only, to the host, synchronously (programs get the
+ * host's input otherwise: see the doorbell, irq.c). It is printk's console
+ * from setup_arch on, and /dev/console (a plain character device: no tty
+ * layer, CONFIG_TTY=n) is /init's stdin, stdout and stderr: a write hands
+ * the program's bytes to the host as they are, a read is at its end.
+ */
+#include <linux/console.h>
+#include <linux/device.h>
+#include <linux/fs.h>
+#include <linux/init.h>
+#include <linux/major.h>
+#include <linux/uaccess.h>
+#include <asm/wasm.h>
+
+static void wasm_console_write_con(struct console *con, const char *s,
+				   unsigned int n)
+{
+	wasm_console_write(s, n);
+}
+
+struct console wasm_console = {
+	.name	= "wasm",
+	.write	= wasm_console_write_con,
+	.flags	= CON_PRINTBUFFER,
+	.index	= 0,
+};
+
+/*
+ * A program's memory is kernel memory (NOMMU), which the host reads
+ * directly: no copy, only the check that the bytes are the program's.
+ */
+static ssize_t console_dev_write(struct file *file, const char __user *buf,
+				 size_t count, loff_t *ppos)
+{
+	if (!access_ok(buf, count))
+		return -EFAULT;
+	wasm_console_write((const char __force *)buf, count);
+	return count;
+}
+
+static ssize_t console_dev_read(struct file *file, char __user *buf,
+				size_t count, loff_t *ppos)
+{
+	return 0;
+}
+
+static const struct file_operations console_dev_fops = {
+	.write	= console_dev_write,
+	.read	= console_dev_read,
+	.llseek	= noop_llseek,
+};
+
+/* /dev/console (5, 1), as the tty layer would have made it. */
+static int __init console_dev_init(void)
+{
+	struct class *cls;
+	int ret;
+
+	ret = register_chrdev(TTYAUX_MAJOR, "console", &console_dev_fops);
+	if (ret)
+		return ret;
+	cls = class_create("console");
+	if (IS_ERR(cls))
+		return PTR_ERR(cls);
+	return PTR_ERR_OR_ZERO(device_create(cls, NULL, MKDEV(TTYAUX_MAJOR, 1),
+					     NULL, "console"));
+}
+device_initcall(console_dev_init);
diff --git a/arch/wasm/kernel/irq.c b/arch/wasm/kernel/irq.c
new file mode 100644
index 000000000..1b64b0177
--- /dev/null
+++ b/arch/wasm/kernel/irq.c
@@ -0,0 +1,66 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Interrupts.
+ *
+ * The host never interrupts running wasm code. It raises an interrupt by
+ * setting a bit in wasm_irq_pending (and waking the CPU if it idles); the kernel
+ * takes pending interrupts when it re-enables interrupts and when the CPU
+ * idles, which are the points real hardware would deliver them to a
+ * PREEMPT_NONE kernel that has interrupts masked in between.
+ */
+#include <linux/cpu.h>
+#include <linux/hardirq.h>
+#include <linux/init.h>
+#include <linux/irqflags.h>
+#include <linux/sched.h>
+#include <linux/sched/signal.h>
+#include <linux/sched/task_stack.h>
+#include <asm/irq_regs.h>
+#include <asm/wasm.h>
+
+unsigned long wasm_irq_flags = ARCH_IRQ_DISABLED;
+int wasm_irq_pending;
+
+/*
+ * The doorbell: the host has something for a task (a program waiting for
+ * it, as /init waits for the page's calls, in a futex on a word the host
+ * has written: woken, the wait sees the word changed and returns).
+ */
+static void wasm_ring(void)
+{
+	struct task_struct *p;
+
+	while ((p = wasm_doorbell()))
+		wake_up_process(p);
+}
+
+void wasm_deliver_irqs(void)
+{
+	struct pt_regs *old_regs;
+	int pending;
+
+	while ((pending = READ_ONCE(wasm_irq_pending))) {
+		WRITE_ONCE(wasm_irq_pending, 0);
+		wasm_irq_flags = ARCH_IRQ_DISABLED;
+		old_regs = set_irq_regs(task_pt_regs(current));
+		irq_enter();
+		if (pending & BIT(WASM_IRQ_TIMER))
+			wasm_timer_interrupt();
+		if (pending & BIT(WASM_IRQ_DOORBELL))
+			wasm_ring();
+		irq_exit();
+		set_irq_regs(old_regs);
+		wasm_irq_flags = ARCH_IRQ_ENABLED;
+	}
+}
+
+void __init init_IRQ(void)
+{
+}
+
+/* Called with interrupts disabled; returns with them enabled. */
+void arch_cpu_idle(void)
+{
+	wasm_idle();
+	raw_local_irq_enable();
+}
diff --git a/arch/wasm/kernel/process.c b/arch/wasm/kernel/process.c
new file mode 100644
index 000000000..cd106e6ec
--- /dev/null
+++ b/arch/wasm/kernel/process.c
@@ -0,0 +1,95 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Tasks and context switching. The kernel is one wasm instance, on one
+ * thread; a task's context is a call stack of it, which the host suspends
+ * and resumes (JSPI). __switch_to() asks the host to hand the CPU to the
+ * next task: it resumes that task's stack (or starts it, task_entry) and
+ * suspends this one, until the CPU is handed back to it.
+ */
+#include <linux/entry-common.h>
+#include <linux/sched.h>
+#include <linux/sched/debug.h>
+#include <linux/sched/task.h>
+#include <linux/sched/task_stack.h>
+#include <linux/printk.h>
+#include <asm/switch_to.h>
+#include <asm/wasm.h>
+
+/* The task that most recently switched away on this CPU. */
+static struct task_struct *wasm_last;
+
+struct task_struct *__switch_to(struct task_struct *prev,
+				struct task_struct *next)
+{
+	wasm_last = prev;
+	wasm_switch_task(prev, next, READ_ONCE(prev->__state) == TASK_DEAD);
+	__current_task = prev;
+	return wasm_last;
+}
+
+/* Called by the host, on a new task's stack, when it first gets the CPU. */
+__wasm_export(task_entry) void wasm_task_entry(struct task_struct *p)
+{
+	__current_task = p;
+	schedule_tail(wasm_last);
+
+	/* A kernel thread returns only after a successful kernel_execve(). */
+	if (p->thread.fn)
+		p->thread.fn(p->thread.fn_arg);
+	wasm_enter_user();
+}
+
+/* Called by the host, on a fresh stack for the current task (see syscall.c). */
+__wasm_export(user_entry) void wasm_user_entry(void)
+{
+	wasm_enter_user();
+}
+
+/*
+ * Return to user mode, at the start of the task's program (a direct call:
+ * nothing of the host's may be on a stack the host suspends). Returning
+ * from it is an exit.
+ */
+void __noreturn wasm_enter_user(void)
+{
+	syscall_exit_to_user_mode(current_pt_regs());
+	current->thread.entry();
+	do_exit(0);
+}
+
+int copy_thread(struct task_struct *p, const struct kernel_clone_args *args)
+{
+	struct pt_regs *regs = task_pt_regs(p);
+
+	/*
+	 * A user clone cannot return twice (wasm has no way to copy a call
+	 * stack): the child starts over, at its program's clone entry. It
+	 * shares its parent's memory: without CLONE_VM, it would need a copy
+	 * at the same addresses, which NOMMU cannot give. No CLONE_SETTLS:
+	 * programs have no thread-local storage (a module with some does not
+	 * load: see the host's user_start).
+	 */
+	if (!args->fn && (!(args->flags & CLONE_VM) || (args->flags & CLONE_SETTLS) ||
+			  !current->thread.clone_entry))
+		return -EINVAL;
+
+	memset(regs, 0, sizeof(*regs));
+	p->thread.fn = args->fn;
+	p->thread.fn_arg = args->fn_arg;
+
+	wasm_spawn_task(p, regs);
+	if (!args->fn) {
+		p->thread.entry = current->thread.clone_entry;
+		wasm_clone_user(p, args->stack);
+	}
+	return 0;
+}
+
+void flush_thread(void)
+{
+}
+
+void show_regs(struct pt_regs *regs)
+{
+	show_regs_print_info(KERN_DEFAULT);
+}
