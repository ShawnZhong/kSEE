diff --git a/arch/wasm/lib/delay.c b/arch/wasm/lib/delay.c
new file mode 100644
index 000000000..04dc64b20
--- /dev/null
+++ b/arch/wasm/lib/delay.c
@@ -0,0 +1,33 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Delays spin on the host's clock (one thread: nothing to sleep on; there
+ * is no cycle counter).
+ */
+#include <linux/delay.h>
+#include <linux/math64.h>
+#include <asm/wasm.h>
+
+void __ndelay(unsigned long nsecs)
+{
+	u64 end = wasm_time_ns() + nsecs;
+
+	while (wasm_time_ns() < end)
+		cpu_relax();
+}
+
+void __udelay(unsigned long usecs)
+{
+	__ndelay(usecs * NSEC_PER_USEC);
+}
+
+/* xloops is usecs * 2^32 / 10^6 (see asm-generic/delay.h). */
+void __const_udelay(unsigned long xloops)
+{
+	__ndelay(((u64)xloops * NSEC_PER_SEC) >> 32);
+}
+
+/* A "loop" is a nanosecond (see preset_lpj in setup_arch()). */
+void __delay(unsigned long loops)
+{
+	__ndelay(loops * (NSEC_PER_SEC / HZ / (1000000 / HZ)));
+}
diff --git a/arch/wasm/lib/multi3.c b/arch/wasm/lib/multi3.c
new file mode 100644
index 000000000..9577f3a99
--- /dev/null
+++ b/arch/wasm/lib/multi3.c
@@ -0,0 +1,30 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * 128-bit multiply, which clang emits as a libcall on wasm32 (the kernel
+ * does not link compiler-rt). Uses only 64-bit arithmetic.
+ */
+#include <linux/types.h>
+
+typedef union {
+	__int128 ti;
+	struct {
+		u64 low;
+		u64 high;
+	} s;
+} twords;
+
+__int128 __multi3(__int128 a, __int128 b);
+
+__int128 __multi3(__int128 a, __int128 b)
+{
+	twords x = { .ti = a }, y = { .ti = b }, r;
+	u64 a0 = (u32)x.s.low, a1 = x.s.low >> 32;
+	u64 b0 = (u32)y.s.low, b1 = y.s.low >> 32;
+	u64 p00 = a0 * b0, p01 = a0 * b1, p10 = a1 * b0, p11 = a1 * b1;
+	u64 mid = (p00 >> 32) + (u32)p01 + (u32)p10;
+
+	r.s.low = (mid << 32) | (u32)p00;
+	r.s.high = p11 + (p01 >> 32) + (p10 >> 32) + (mid >> 32) +
+		   x.s.high * y.s.low + x.s.low * y.s.high;
+	return r.ti;
+}
diff --git a/arch/wasm/lib/uaccess.c b/arch/wasm/lib/uaccess.c
new file mode 100644
index 000000000..2af663902
--- /dev/null
+++ b/arch/wasm/lib/uaccess.c
@@ -0,0 +1,43 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * A user string is kernel memory (NOMMU: see asm/uaccess.h), so it is
+ * measured and copied as one: not word by word, as lib/strncpy_from_user.c
+ * reads memory it may not be able to touch. It may run up to where memory
+ * ends (high_memory), not past it.
+ */
+#include <linux/minmax.h>
+#include <linux/string.h>
+#include <linux/uaccess.h>
+
+/* The bytes at `src` memory has, up to `count`; 0 if none. */
+static long user_room(const char __user *src, long count)
+{
+	if (count <= 0 || !access_ok(src, 1))
+		return 0;
+	return min_t(unsigned long, count, (unsigned long)high_memory - (unsigned long)src);
+}
+
+long strncpy_from_user(char *dst, const char __user *src, long count)
+{
+	long room = user_room(src, count), n;
+
+	if (count <= 0)
+		return 0;
+	n = strnlen((const char __force *)src, room);
+	if (!room || (n == room && room < count))
+		return -EFAULT;
+	memcpy(dst, (const void __force *)src, n < count ? n + 1 : count);
+	return n;
+}
+
+long strnlen_user(const char __user *src, long count)
+{
+	long room = user_room(src, count), n;
+
+	if (!room)
+		return 0;
+	n = strnlen((const char __force *)src, room);
+	if (n == room && room < count)
+		return 0;
+	return n < count ? n + 1 : count + 1;
+}
