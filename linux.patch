+#!/bin/sh
+# SPDX-License-Identifier: GPL-2.0-only
+#
+# llvm-objcopy wrapper. The generic vmlinux rule strips .modinfo with
+# ELF-only options; in wasm, .modinfo is a data segment, not a section, and
+# stays. Copy the file instead.
+
+case "$1" in
+--set-section-flags)	cp "$3" "$4" ;;	# --set-section-flags X in out
+--remove-section=.modinfo) ;;
+*)			exec $WASM_OBJCOPY "$@" ;;
+esac
diff --git a/arch/wasm/scripts/wasm-ld b/arch/wasm/scripts/wasm-ld
new file mode 100755
index 000000000..6760829dd
--- /dev/null
+++ b/arch/wasm/scripts/wasm-ld
@@ -0,0 +1,28 @@
+#!/bin/sh
+# SPDX-License-Identifier: GPL-2.0-only
+#
+# wasm-ld wrapper. wasm-ld has no linker scripts: the "script"
+# (arch/wasm/kernel/vmlinux.lds.S) is wasm assembly that fixes the data
+# layout, so assemble it and link it ahead of everything else. Also drop the
+# GNU ld options wasm-ld rejects.
+
+set -e
+script=
+skip=
+for arg; do
+	shift
+	[ -n "$skip" ] && { skip=; continue; }
+	case $arg in
+	--script=*)	script=${arg#--script=} ;;
+	-z)		skip=1 ;;
+	--start-group|--end-group|-EL) ;;
+	*)		set -- "$@" "$arg" ;;
+	esac
+done
+
+[ -z "$script" ] && exec $WASM_LD "$@"
+
+head=$(mktemp --suffix=.o)
+trap 'rm -f "$head"' EXIT
+$WASM_CC --target=wasm32 -x assembler -c "$script" -o "$head"
+$WASM_LD "$head" "$@"
