{
  "title": "What happens in read()?",
  "question": "A program asks for 64 bytes of a file. Which parts of the kernel does that go through?",
  "steps": [
    {
      "show": "mkdirat(AT_FDCWD, \"/tmp\", 0755)",
      "call": "mkdirat",
      "args": [
        -100,
        "/tmp",
        493
      ],
      "stops": []
    },
    {
      "show": "openat(AT_FDCWD, \"/tmp/note\", O_CREAT | O_WRONLY | O_TRUNC, 0644)",
      "call": "openat",
      "args": [
        -100,
        "/tmp/note",
        577,
        420
      ],
      "stops": []
    },
    {
      "show": "write(fd, \"hello from the page cache\\n\", 26)",
      "call": "write",
      "args": [
        {
          "ret": 1
        },
        "hello from the page cache\n",
        26
      ],
      "stops": []
    },
    {
      "show": "close(fd)",
      "call": "close",
      "args": [
        {
          "ret": 1
        }
      ],
      "stops": []
    },
    {
      "show": "openat(AT_FDCWD, \"/tmp/note\", O_RDONLY)",
      "call": "openat",
      "args": [
        -100,
        "/tmp/note",
        0,
        0
      ],
      "stops": []
    },
    {
      "show": "read(fd, buf, 64)",
      "call": "read",
      "args": [
        {
          "ret": 4
        },
        {
          "size": 64
        },
        64
      ],
      "stops": [
        {
          "func": "ksys_read",
          "note": "The syscall itself: fdget_pos turns the fd into the open file (a struct file), and the position to read at."
        },
        {
          "func": "vfs_read",
          "note": "The VFS, the same for every filesystem: is the file open for reading, is the range sane? Then it calls the filesystem's own read_iter."
        },
        {
          "func": "filemap_read",
          "note": "The page cache: a file's data lives in memory pages. Find the page for the position, and copy from it to the program."
        }
      ]
    },
    {
      "show": "close(fd)",
      "call": "close",
      "args": [
        {
          "ret": 4
        }
      ],
      "stops": []
    }
  ]
