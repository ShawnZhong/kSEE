{
  "title": "Directories on ext4",
  "question": "A directory is a file of names, each pointing to an inode. What happens when one is made, listed, renamed in, and removed?",
  "steps": [
    {
      "call": "mkdirat",
      "args": [
        "AT_FDCWD",
        "\"/mnt/dir\"",
        "0755"
      ],
      "stops": [
        {
          "func": "ext4_mkdir",
          "note": "A new directory, all in one journal transaction."
        },
        {
          "func": "__ext4_new_inode",
          "note": "A free inode for it, from a block group's inode bitmap."
        },
        {
          "func": "ext4_init_new_dir",
          "note": "Its first block, with its own two entries: \".\" (itself) and \"..\" (its parent)."
        },
        {
          "func": "ext4_add_entry",
          "note": "The name \"dir\": into a block of /mnt, the parent."
        }
      ]
    },
    {
      "call": "openat",
      "args": [
        "AT_FDCWD",
        "\"/mnt/dir/a\"",
        "O_CREAT | O_WRONLY",
        "0644"
      ],
      "stops": [
        {
          "func": "ext4_create",
          "note": "A file in it: another inode, and another name, now in dir's block."
        }
      ]
    },
    {
      "call": "close",
      "args": [
        "$2"
      ]
    },
    {
      "call": "openat",
      "args": [
        "AT_FDCWD",
        "\"/mnt/dir\"",
        "O_RDONLY | O_DIRECTORY"
      ]
    },
    {
      "call": "getdents64",
      "args": [
        "$4",
        "[256]",
        "256"
      ],
      "stops": [
        {
          "func": "ext4_readdir",
          "note": "Read the directory's blocks, entry by entry."
        },
        {
          "func": "filldir64",
          "note": "Each entry, copied out to the program: \".\", \"..\", \"a\"."
        }
      ]
    },
    {
      "call": "close",
      "args": [
        "$4"
      ]
    },
    {
      "call": "renameat2",
      "args": [
        "AT_FDCWD",
        "\"/mnt/dir/a\"",
        "AT_FDCWD",
        "\"/mnt/dir/b\"",
        "0"
      ],
      "stops": [
        {
          "func": "ext4_rename",
          "note": "In one directory: the entry's name changes, \"a\" to \"b\"; the inode stays as it is."
        }
      ]
    },
    {
      "call": "unlinkat",
      "args": [
        "AT_FDCWD",
        "\"/mnt/dir\"",
        "AT_REMOVEDIR"
      ],
      "stops": [
        {
          "func": "ext4_empty_dir",
          "note": "Is it empty? No (\"b\"): the call fails, ENOTEMPTY."
        }
      ]
    },
    {
      "call": "unlinkat",
      "args": [
        "AT_FDCWD",
        "\"/mnt/dir/b\"",
        "0"
      ],
      "stops": [
        {
          "func": "ext4_free_inode",
          "note": "\"b\" was the file's only name, and nobody has it open: its inode is freed."
        }
      ]
    },
    {
      "call": "unlinkat",
      "args": [
        "AT_FDCWD",
        "\"/mnt/dir\"",
        "AT_REMOVEDIR"
      ],
      "stops": [
        {
          "func": "ext4_free_blocks",
          "note": "Now empty: the directory's block goes back to the block bitmap, and its inode is freed."
        }
      ]
    }
  ]
}
