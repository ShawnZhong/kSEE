{
  "title": "How do two processes talk through a pipe?",
  "question": "/init makes a pipe, starts a child, and the two talk. What does the kernel do as one process waits for the other?",
  "steps": [
    {
      "call": "pipe2",
      "args": [
        "[8]",
        "0"
      ],
      "stops": [
        {
          "func": "create_pipe_files",
          "note": "A pipe: a buffer in the kernel, and two files for it: fd 3 reads, fd 4 writes."
        }
      ]
    },
    {
      "call": "clone",
      "args": [
        "CLONE_VM | CLONE_VFORK | SIGCHLD",
        "0",
        "NULL",
        "NULL",
        "0"
      ],
      "stops": [
        {
          "func": "copy_process",
          "note": "A child process (vfork: no MMU, so it borrows /init's memory instead of copying it). It gets copies of /init's fds: the pipe's too."
        },
        {
          "func": "wait_for_vfork_done",
          "note": "Until the child runs a program of its own (or exits), /init waits: the call blocks."
        }
      ]
    },
    {
      "call": "execve",
      "args": [
        "\"/init\"",
        "NULL",
        "NULL"
      ],
      "as": 2,
      "stops": [
        {
          "func": "begin_new_exec",
          "note": "The child runs a new program (/init again): memory of its own now."
        },
        {
          "func": "complete_vfork_done",
          "note": "So /init need not wait any more: its clone returns the child's pid."
        }
      ]
    },
    {
      "call": "close",
      "args": [
        "4"
      ],
      "stops": [
        {
          "func": "file_close_fd",
          "note": "/init keeps the reading end only."
        }
      ]
    },
    {
      "call": "close",
      "args": [
        "3"
      ],
      "as": 2,
      "stops": [
        {
          "func": "file_close_fd",
          "note": "The child keeps the writing end only."
        }
      ]
    },
    {
      "call": "read",
      "args": [
        "3",
        "[64]",
        "64"
      ],
      "stops": [
        {
          "func": "anon_pipe_read",
          "note": "The pipe is empty, and a writer is left (the child's fd 4): wait for data. The call blocks."
        },
        {
          "func": "schedule",
          "note": "Give the CPU away."
        }
      ]
    },
    {
      "call": "write",
      "args": [
        "4",
        "\"hello\\n\"",
        "6"
      ],
      "as": 2,
      "stops": [
        {
          "func": "anon_pipe_write",
          "note": "Into the pipe's buffer..."
        },
        {
          "func": "try_to_wake_up",
          "note": "...and wake the reader: /init's read returns the 6 bytes.",
          "any": true
        }
      ]
    },
    {
      "call": "exit_group",
      "args": [
        "7"
      ],
      "as": 2,
      "stops": [
        {
          "func": "do_exit",
          "note": "The child exits: its files close (the pipe has no writer now)."
        },
        {
          "func": "exit_notify",
          "note": "It tells its parent (SIGCHLD), and stays a zombie until the parent asks how it ended."
        }
      ]
    },
    {
      "call": "read",
      "args": [
        "3",
        "[64]",
        "64"
      ],
      "stops": [
        {
          "func": "anon_pipe_read",
          "note": "Empty, and no writer left: 0, end of file."
        }
      ]
    },
    {
      "call": "waitid",
      "args": [
        "P_PID",
        "$2",
        "[128]",
        "WEXITED",
        "NULL"
      ],
      "stops": [
        {
          "func": "do_wait",
          "note": "How did the child end? (Its siginfo: exited, with status 7.)"
        },
        {
          "func": "release_task",
          "note": "Reap the zombie: the child is gone."
        }
      ]
    }
  ]
}
